Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: "@NAMESPACE@/odom"
    Background Color: 20; 28; 40
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: ENU Reference Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: Schematic Robot (not hydrodynamics)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /@NAMESPACE@/robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
    - Class: rviz_default_plugins/Odometry
      Name: Ground Truth Debug State
      Enabled: true
      Topic:
        Value: /@NAMESPACE@/state/odometry
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Keep: 1
    - Class: rviz_default_plugins/Image
      Name: Left RGB
      Enabled: true
      Topic:
        Value: /@NAMESPACE@/sensors/stereo/left/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/Image
      Name: Right RGB
      Enabled: true
      Topic:
        Value: /@NAMESPACE@/sensors/stereo/right/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5
      Pitch: 0.45
      Yaw: 0.75
      Target Frame: "@NAMESPACE@/base_link"
Window Geometry:
  Width: 1600
  Height: 900
  QMainWindow State: ""
