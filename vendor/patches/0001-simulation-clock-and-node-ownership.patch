+// SPDX-License-Identifier: GPL-3.0-or-later
+// One simulator per process. Step time is shared with the rendering callback.
+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <rclcpp/rclcpp.hpp>
+namespace sf {
+inline std::atomic<int64_t> uw_step_time_ns{0};
+inline rclcpp::Time UWClockNow() {
+    return rclcpp::Time(uw_step_time_ns.load(), RCL_ROS_TIME);
+}
+}
