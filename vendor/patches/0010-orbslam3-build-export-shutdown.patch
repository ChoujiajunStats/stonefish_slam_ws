+System::ResearchSnapshot System::GetResearchSnapshot()
+{
+    ResearchSnapshot out;
+    out.maps = mpAtlas->CountMaps();
+    // PreSave marks empty maps bad; GetCurrentMap would then wait forever.
+    // After shutdown only export the sole nonempty retained map, if present.
+    Map* map = nullptr;
+    if(isShutDown()) {
+        auto maps = mpAtlas->GetAllMaps();
+        if(maps.size()!=1) return out;
+        map = maps.front();
+    } else map = mpAtlas->GetCurrentMap();
+    if(!map || map->IsBad()) return out;
+    unique_lock<mutex> update(map->mMutexMapUpdate);
+    out.map_id = map->GetId();
+    out.big_changes = map->GetLastBigChangeIdx();
+    for(MapPoint* point : map->GetAllMapPoints())
+        if(point && !point->isBad()) out.points.push_back(point->GetWorldPos());
+    for(KeyFrame* frame : map->GetAllKeyFrames())
+        if(frame && !frame->isBad()) {
+            out.keyframes.push_back({frame->mnId, frame->mTimeStamp, frame->GetPoseInverse()});
+            out.loop_edges += frame->GetLoopEdges().size();
+        }
+    out.loop_edges /= 2; // undirected accepted keyframe loop edges, not event count
+    std::sort(out.keyframes.begin(), out.keyframes.end(),
+        [](const ResearchKeyFrame& a, const ResearchKeyFrame& b){return a.stamp < b.stamp;});
+    return out;
+}
