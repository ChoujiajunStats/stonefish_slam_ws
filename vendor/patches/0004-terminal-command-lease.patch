+// SPDX-License-Identifier: GPL-3.0-or-later
+// Opt-in simulation receiver. No dependency on project control packages.
+#pragma once
+#include <rclcpp/rclcpp.hpp>
+#include <std_msgs/msg/string.hpp>
+#include <Stonefish/core/Robot.h>
+#include <Stonefish/actuators/Thruster.h>
+#include <mutex>
+#include <thread>
+#include <atomic>
+#include <vector>
+#include <string>
+namespace sf {
+class UWTerminal {
+public:
+    UWTerminal(std::shared_ptr<rclcpp::Node> node, Robot* robot,
+               const std::string& run, const std::string& secret, bool fixture);
+    ~UWTerminal();
+    void BeforeStep();
+    void AfterStep();
+    int64_t ClockValue(int64_t raw);
+private:
+    void Gate(const std_msgs::msg::String::SharedPtr msg);
+    void Output(const std_msgs::msg::String::SharedPtr msg);
+    void Fixture(const std_msgs::msg::String::SharedPtr msg);
+    void Check(int64_t now);
+    void Fault(const std::string& reason, int64_t now);
+    void Report();
+    std::shared_ptr<rclcpp::Node> node_;
+    Robot* robot_;
+    std::string run_, secret_, token_, state_{"DISARMED"}, reason_{"startup"}, model_;
+    std::vector<Thruster*> thrusters_;
+    std::vector<std::string> names_;
+    std::vector<double> values_, applied_, rpm_, thrust_, torque_;
+    uint64_t generation_{0}, output_seq_{0}, gate_seq_{0}, request_seq_{0};
+    int64_t armed_ns_{0}, lease_ns_{0}, output_ns_{0}, deadline_ns_{0},
+            fault_ns_{0}, neutral_ns_{0}, applied_ns_{0}, physics_ns_{0};
+    std::mutex mutex_;
+    rclcpp::executors::SingleThreadedExecutor executor_;
+    std::thread worker_;
+    rclcpp::Subscription<std_msgs::msg::String>::SharedPtr gate_, output_, fixture_;
+    rclcpp::Publisher<std_msgs::msg::String>::SharedPtr report_;
+    rclcpp::TimerBase::SharedPtr timer_;
+    std::atomic<bool> clock_hold_{false};
+    std::atomic<int64_t> clock_offset_{0}, clock_last_{0};
+};
+}
